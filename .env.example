# Shared by both apps. Never use NEXT_PUBLIC_ for database credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anandham
# Public canonical origin for metadata and sitemap URLs.
LIBRARY_SITE_URL=https://anandham.online
# Optional reader backend when deployed without a direct database connection.
# LIBRARY_API_URL=https://web-user-production-b9c9.up.railway.app/api
# Verification codes from Google Search Console and Bing Webmaster Tools.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# INDEXNOW_KEY=generated-host-verification-key
# Only needed on first db:setup; existing accounts are not overwritten.
LIBRARY_ADMIN_EMAIL=admin@example.com
LIBRARY_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
LIBRARY_MODE=true
LIBRARY_ADMIN_ORIGIN=http://localhost:3001
LIBRARY_READER_URL=http://localhost:3000
