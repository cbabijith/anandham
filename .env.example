# Only needed on first db:setup; existing accounts are not overwritten.
LIBRARY_ADMIN_EMAIL=admin@example.com
LIBRARY_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters
LIBRARY_MODE=true
LIBRARY_ADMIN_ORIGIN=http://localhost:3001
LIBRARY_READER_URL=http://localhost:3000
